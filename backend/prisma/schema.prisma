/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model request_attachments {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id                String                   @db.Uuid
  document_id               String                   @db.Uuid
  version                   Int
  filename                  String
  mime_type                 String
  byte_size                 Int
  sha256                    String
  content                   Bytes
  uploaded_by_assignment_id String                   @db.Uuid
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  archived_at               DateTime?                @db.Timestamptz(6)
  requests                  requests                 @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee_assignments      employee_assignments     @relation(fields: [uploaded_by_assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submission_attachments    submission_attachments[]

  @@unique([request_id, document_id, version])
  @@index([request_id, created_at], map: "attachment_request")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model request_comments {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id           String               @db.Uuid
  actor_assignment_id  String               @db.Uuid
  body                 String
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  employee_assignments employee_assignments @relation(fields: [actor_assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests             requests             @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sla_events {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id        String         @db.Uuid
  event          String
  detail         String?
  occurred_at    DateTime       @default(now()) @db.Timestamptz(6)
  approval_tasks approval_tasks @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([task_id, event])
}

model submission_attachments {
  submission_id       String              @db.Uuid
  attachment_id       String              @db.Uuid
  request_attachments request_attachments @relation(fields: [attachment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request_submissions request_submissions @relation(fields: [submission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([submission_id, attachment_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model task_transfers {
  id                                                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_task_id                                               String                @unique @db.Uuid
  to_task_id                                                 String                @unique @db.Uuid
  actor_assignment_id                                        String?               @db.Uuid
  delegation_id                                              String?               @db.Uuid
  kind                                                       String
  reason                                                     String
  occurred_at                                                DateTime              @default(now()) @db.Timestamptz(6)
  employee_assignments                                       employee_assignments? @relation(fields: [actor_assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_delegations                                       approval_delegations? @relation(fields: [delegation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_tasks_task_transfers_from_task_idToapproval_tasks approval_tasks        @relation("task_transfers_from_task_idToapproval_tasks", fields: [from_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_tasks_task_transfers_to_task_idToapproval_tasks   approval_tasks        @relation("task_transfers_to_task_idToapproval_tasks", fields: [to_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}



