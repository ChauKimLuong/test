digraph FlowPilot { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.65",fontname="Arial",label="FlowPilot — Mô hình dữ liệu quy trình phê duyệt",labelloc=t,fontsize=22]; node [shape=box,style="rounded,filled",fillcolor="#f3f7fd",color="#173453",fontname="Arial",fontsize=12,margin="0.15,0.12"]; edge [color="#63748a",fontname="Arial",fontsize=10];
subgraph cluster_org {label="Tổ chức và quyền";color="#ccd6e2";User [label="User\nid · email · status"];Assignment [label="EmployeeAssignment\nunit · position · manager\nstartedAt · endedAt"];Unit [label="OrganizationalUnit\nparent · type"];Role [label="RoleAssignment\nrole · scope · hiệu lực"];User->Assignment [label="1 : nhiều"];Unit->Assignment;Assignment->Role;}
subgraph cluster_definition {label="Mẫu và định nghĩa";color="#ccd6e2";Template [label="FormTemplate\nversion · status"];TemplateRevision [label="FormTemplateRevision\nsnapshot bất biến"];Workflow [label="Workflow\ndraft · revision · published"];Version [label="WorkflowVersion\ndefinition · templateVersion\npublishedAt · actor",fillcolor="#eaf1ff"];Template->TemplateRevision;Template->Workflow [label="1 : 1"];Workflow->Version [label="1 : nhiều"];}
subgraph cluster_runtime {label="Hồ sơ và thực thi";color="#ccd6e2";Request [label="Request\ncode · formData · templateSnapshot\nstatus · revision"];Submission [label="RequestSubmission\nround · data snapshot"];Instance [label="WorkflowInstance\npinned version · round\ncurrentStep · status",fillcolor="#eaf1ff"];Step [label="WorkflowStepRun\nround · step · ALL/ANY\nconditionResult · status"];Task [label="ApprovalTask\nassignee + snapshot\nstatus · timestamps",fillcolor="#e8f5ef"];Decision [label="TaskDecision\nactor · decision · comment\nappend-only"];Audit [label="AuditLog / Notification\nlịch sử và thông báo"];Request->Submission [label="1 : nhiều"];Request->Instance [label="1 : 0..1"];Instance->Step [label="1 : nhiều"];Step->Task [label="1 : nhiều"];Task->Decision [label="1 : 0..1"];Request->Audit;}
Assignment->Request [label="người gửi"];Assignment->Task [label="được giao"];Workflow->Request;Version->Instance [label="pinned"];}